# Copy to docker/box.env on the host (chmod 600). Read by docker/compose.sh for
# the production compose file only; the app containers never see these values.

# How the app is reached (docs/networking.md), comma-separated:
#   tailscale    only on the tailnet: https://herdbook.<tailnet>.ts.net
#   lan          on the local network: HTTPS by Caddy (LAN_* below)
#   vaultwarden  the password vault, always on the tailnet (TAILNET_DOMAIN)
# At least tailscale or lan; both is fine. After a change: docker/up.sh.
COMPOSE_PROFILES=tailscale,vaultwarden

# Bind mounts for storage/app, Vaultwarden and Caddy (docs/deployment.md#data-directories).
DATA_DIR=/srv/herdbook-data

# --- tailscale and vaultwarden -----------------------------------------------

# <tailnet>.ts.net, as shown in the Tailscale admin console (DNS page).
TAILNET_DOMAIN=

# Tagged auth keys (admin console → Settings → Keys). Only needed for the very
# first start: the node identity then lives in a Docker volume. Remove them
# afterwards, then run docker/up.sh.
TS_AUTHKEY_HERDBOOK=
TS_AUTHKEY_VAULT=

# true only while creating the Vaultwarden accounts, then false + docker/up.sh.
VAULT_SIGNUPS_ALLOWED=false

# Empty: the Vaultwarden /admin page is off. To enable it, put an argon2 hash
# here IN SINGLE QUOTES (it contains `$`, which compose would otherwise expand):
#   docker run --rm -it vaultwarden/server:<tag> /vaultwarden hash   (the tag from docker/docker-compose.prod.yml)
VAULT_ADMIN_TOKEN=

# --- lan ---------------------------------------------------------------------

# The host's address on the local network: give it a fixed one (a DHCP
# reservation in the router). HTTPS is published on this address only, and
# https://<LAN_IP> works too.
LAN_IP=

# Optional: names for the host in your local DNS, separated by spaces, e.g.
# herdbook.home.arpa. Caddy issues a certificate for each, and for LAN_IP.
LAN_HOSTNAMES=
LAN_PORT=443

# --- always ------------------------------------------------------------------

# openssl rand -hex 24
DB_ROOT_PASSWORD=
