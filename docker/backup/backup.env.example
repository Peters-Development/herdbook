# Copy to /etc/herdbook/backup.env (chmod 600, owner root). No comment after a
# value: systemd reads it as part of the value.

# Where the backup goes (docs/backups.md). restic encrypts the data itself,
# wherever it lands.
#
# On the host itself, preferably on a second disk: protects against mistakes
# (a bad migration, something deleted, a broken database), not against a
# broken disk, theft or fire. The host then prunes old snapshots itself.
RESTIC_REPOSITORY=/srv/herdbook-backup
PRUNE_ON_BOX=true
#
# Or: the append-only rest-server on a NAS, over Tailscale. The NAS prunes
# (docker/backup/prune.sh), the host cannot delete there. The .htpasswd user
# of the rest-server, with a hex password (openssl rand -hex 24): no
# characters that break a URL or a shell.
# RESTIC_REPOSITORY=rest:http://nas.<tailnet>.ts.net:8000/herdbook/
# PRUNE_ON_BOX=false
# RESTIC_REST_USERNAME=herdbook
# RESTIC_REST_PASSWORD=

# The repository password, one line, chmod 600. Also keep it OFF the host
# (on paper): without it the backup cannot be read.
RESTIC_PASSWORD_FILE=/etc/herdbook/restic-password

# The checkout; the data directory is read from its docker/box.env.
HERDBOOK_DIR=/srv/herdbook

# A failed backup is reported through the app, on the same channels as the
# checks (herdbook-backup-failed.service). When the app or its database is
# down too, it goes straight to this ntfy topic instead; the app's NTFY_URL is
# fine. Recommended: a backup often fails because something else is broken.
# Empty: no fallback.
NTFY_URL=
NTFY_TOKEN=
