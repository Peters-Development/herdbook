APP_NAME=Herdbook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:16000
# Times are stored in UTC and shown in this zone, e.g. Europe/Amsterdam
# or America/New_York (config/herdbook.php).
HERDBOOK_DISPLAY_TIMEZONE=UTC
# The symbol in front of every amount; there is no conversion (config/herdbook.php).
HERDBOOK_CURRENCY_SYMBOL=€

# en or nl: the default language. Each account can pick its own in its profile.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=herdbook
DB_USERNAME=herdbook
DB_PASSWORD=secret
# Local stack only (see the bottom of this file).
DB_ROOT_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="herdbook@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# docker-compose.yml build arg: your own user id (`id -u`)
HOST_UID=501

# Monitoring. Alerts go out on the first channel that works; every channel is
# optional (docs/alerts.md#channels). Pushover: the application token; each
# user puts their own user key in their profile. ntfy: a topic URL, e.g.
# https://ntfy.sh/<long-random-topic>. Email: the MAIL_* above, and each
# user turns it on in their profile.
PUSHOVER_APP_TOKEN=
NTFY_URL=
NTFY_TOKEN=
# The Vaultwarden web vault, for "Open in Vaultwarden" links (docs/vaultwarden.md).
HERDBOOK_VAULT_URL=
# Pinged every five minutes when set (a local monitor or healthchecks.io).
HERDBOOK_HEARTBEAT_URL=

# --- In production (docs/deployment.md#configuration) ---
# APP_ENV=production, APP_DEBUG=false, APP_URL=https://herdbook.<tailnet>.ts.net
# (or the LAN address: docs/networking.md#local-network), LOG_CHANNEL=stderr,
# SESSION_SECURE_COOKIE=true, MAIL_* for your SMTP (or MAIL_MAILER=log: then
# nothing goes out by email).
# DB_ROOT_PASSWORD and HOST_UID are local-only: in production the MySQL root password
# lives in docker/box.env (example: docker/box.env.example), with the host's
# other secrets, so the app containers never see it.
